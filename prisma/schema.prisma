// LedgeWise - Parallel Ledger System for Turmeric Business
// Database: Neon PostgreSQL with Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Account types: Cash, Bank, Loan (informal/formal)
enum AccountType {
  CASH
  BANK
  LOAN_GIVEN     // Money lent out (receivable)
  LOAN_TAKEN     // Money borrowed (payable)
}

// Transaction direction
enum TransactionType {
  IN       // Credit - Money coming in
  OUT      // Debit - Money going out
  TRANSFER // Transfer - Money moving between accounts
}

// Party type
enum PartyType {
  CUSTOMER  // People who sell turmeric to us
  VENDOR    // Big buyers like Priya
  LENDER    // People we borrow from
  BORROWER  // People we lend to
}

// Commodity types for stock tracking
enum CommodityType {
  TURMERIC_RAW
  TURMERIC_POWDER
  MAIZE
  OTHER
}

// Stock movement type
enum StockMovementType {
  PURCHASE     // Buying from farmers
  PROCESSING   // Converting raw to powder
  SALE         // Selling to vendors
  ADJUSTMENT   // Manual adjustments
}

// Whether transaction is official (Tally) or parallel
enum LedgerType {
  OFFICIAL   // Goes to Tally
  PARALLEL   // Kept separate
}

// ============================================
// USERS - Authentication
// ============================================
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String
  isAdmin      Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations - user owns all their data
  accounts       Account[]
  parties        Party[]
  transactions   Transaction[]
  loans          Loan[]
  stocks         Stock[]
  stockMovements StockMovement[]
  categories     Category[]

  @@index([username])
}

// ============================================
// ACCOUNTS - Track Cash, Bank, Loans
// ============================================
model Account {
  id             String      @id @default(cuid())
  name           String      // e.g., "Cash", "HDFC Bank", "SBI Account"
  type           AccountType
  currentBalance Decimal     @default(0) @db.Decimal(15, 2)
  description    String?
  isActive       Boolean     @default(true)
  isDeleted      Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // Owner (optional during migration, will be required after data migration)
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  transactionsFrom Transaction[] @relation("FromAccount")
  transactionsTo   Transaction[] @relation("ToAccount")

  @@index([type])
  @@index([isActive])
  @@index([userId])
  @@index([isDeleted])
}

// ============================================
// PARTIES - Customers, Vendors, Lenders
// ============================================
model Party {
  id           String    @id @default(cuid())
  name         String
  type         PartyType
  phone        String?
  address      String?
  totalDue     Decimal   @default(0) @db.Decimal(15, 2) // Positive = they owe us, Negative = we owe them
  notes        String?
  isActive     Boolean   @default(true)
  isDeleted    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Owner (optional during migration, will be required after data migration)
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  transactions   Transaction[]
  stockMovements StockMovement[]
  loans          Loan[]

  @@index([type])
  @@index([isActive])
  @@index([name])
  @@index([userId])
  @@index([isDeleted])
}

// ============================================
// TRANSACTIONS - All money movements
// ============================================
model Transaction {
  id          String          @id @default(cuid())
  amount      Decimal         @db.Decimal(15, 2)
  type        TransactionType
  date        DateTime        @default(now())
  description String?
  category    String?         // e.g., "Turmeric Purchase", "Loan Repayment", "Transport"
  ledgerType  LedgerType      @default(PARALLEL)

  // Owner (optional during migration, will be required after data migration)
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  // References
  accountId String
  account   Account @relation("FromAccount", fields: [accountId], references: [id])

  // For transfers: destination account
  toAccountId String?
  toAccount   Account? @relation("ToAccount", fields: [toAccountId], references: [id])

  partyId String?
  party   Party?  @relation(fields: [partyId], references: [id])

  // Stock fields (embedded instead of separate StockMovement table)
  stockId           String?             // Reference to Stock item
  stock             Stock?              @relation(fields: [stockId], references: [id])
  stockMovementType StockMovementType?  // PURCHASE, SALE, PROCESSING, ADJUSTMENT
  stockQuantity     Decimal?            @db.Decimal(15, 3) // Quantity in KG
  stockPricePerKg   Decimal?            @db.Decimal(15, 2) // Price per KG

  // Legacy: Link to old stock movement (for migration, will be removed later)
  stockMovementId String?        @unique
  stockMovement   StockMovement? @relation(fields: [stockMovementId], references: [id])

  // Link to loan if this is an EMI payment
  loanId String?
  loan   Loan?   @relation(fields: [loanId], references: [id])

  // Metadata
  receiptNumber String?
  isReconciled  Boolean  @default(false) // Marked when entered in Tally
  isDeleted     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([date])
  @@index([accountId])
  @@index([partyId])
  @@index([ledgerType])
  @@index([isReconciled])
  @@index([category])
  @@index([userId])
  @@index([isDeleted])
  @@index([stockId])
}

// ============================================
// LOANS - Track informal/formal loans
// ============================================
model Loan {
  id           String      @id @default(cuid())
  principal    Decimal     @db.Decimal(15, 2)
  interestRate Decimal     @default(0) @db.Decimal(5, 2) // Annual percentage
  startDate    DateTime    @default(now())
  endDate      DateTime?
  emiAmount    Decimal?    @db.Decimal(15, 2)

  // Current status
  outstandingBalance Decimal @db.Decimal(15, 2)
  totalPaid          Decimal @default(0) @db.Decimal(15, 2)

  // Type: Are we the lender or borrower?
  isGiven Boolean // true = we gave loan, false = we took loan

  // Owner (optional during migration, will be required after data migration)
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  // Party reference
  partyId String
  party   Party  @relation(fields: [partyId], references: [id])

  description String?
  isActive    Boolean  @default(true)
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // EMI payments linked to this loan
  transactions Transaction[]

  @@index([partyId])
  @@index([isActive])
  @@index([isGiven])
  @@index([userId])
  @@index([isDeleted])
}

// ============================================
// STOCK - Track commodity inventory
// ============================================
model Stock {
  id            String        @id @default(cuid())
  commodityType CommodityType
  name          String        // e.g., "Turmeric Finger", "Turmeric Powder Grade A"
  quantity      Decimal       @db.Decimal(15, 3) // In KG
  unit          String        @default("KG")
  avgCostPerKg  Decimal       @default(0) @db.Decimal(15, 2)
  location      String?       // e.g., "Godown 1", "Processing Unit"
  isDeleted     Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Owner (optional during migration, will be required after data migration)
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  // Stock transactions (replaces movements)
  transactions Transaction[]

  // Legacy: old movements (for migration, will be removed later)
  movements StockMovement[]

  @@unique([commodityType, name, location])
  @@index([commodityType])
  @@index([userId])
  @@index([isDeleted])
}

// ============================================
// STOCK MOVEMENTS - Track purchases, sales, processing
// ============================================
model StockMovement {
  id            String            @id @default(cuid())
  type          StockMovementType
  quantity      Decimal           @db.Decimal(15, 3) // In KG
  pricePerKg    Decimal           @db.Decimal(15, 2)
  totalAmount   Decimal           @db.Decimal(15, 2)
  date          DateTime          @default(now())
  description   String?
  vehicleNumber String?           // For tracking shipments
  bagsCount     Int?              // Number of bags
  isDeleted     Boolean           @default(false)

  // Owner (optional during migration, will be required after data migration)
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  // References
  stockId String
  stock   Stock  @relation(fields: [stockId], references: [id])

  partyId String?
  party   Party?  @relation(fields: [partyId], references: [id])

  // Linked transaction (payment)
  transaction Transaction?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([stockId])
  @@index([partyId])
  @@index([type])
  @@index([userId])
  @@index([isDeleted])
}

// ============================================
// CATEGORIES - For transaction categorization
// ============================================
model Category {
  id        String   @id @default(cuid())
  name      String
  icon      String?
  color     String?
  isDefault Boolean  @default(false)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())

  // Owner (null = system default category available to all)
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isDeleted])
  @@index([name])
}
